{
  "manifest_version": 3,
  "name": "QuickAssist Bridge",
  "version": "0.1.0",
  "description": "Передаёт выделенный текст, адрес и (по отдельной команде) текст страницы в настольный «Быстрый помощник».",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Быстрый помощник", "default_popup": "popup.html" },
  "options_page": "options.html",
  "commands": {
    "send-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Отправить выделение в помощник"
    }
  }
}
